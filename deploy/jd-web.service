[Unit]
Description=jd workspace
After=network.target
[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/leo-project/jd
ExecStart=/home/ubuntu/leo-project/jd/.venv/bin/python -m web --port 8775 --public-origin https://d.58nft.net:9453
Restart=on-failure
RestartSec=3
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
